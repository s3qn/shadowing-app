{
  "expo": {
    "name": "Shadowing",
    "slug": "shadowing-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/cat_icon_app.png",
    "scheme": "shadowing",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/cat_icon_app.png",
      "bundleIdentifier": "build.sean.shadowing",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Shadowing records your voice so it can build a language island from what you say.",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E1B3A",
        "foregroundImage": "./assets/images/cat_icon_app.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E1B3A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Shadowing records your voice so it can build a language island from what you say.",
          "enableBackgroundPlayback": true
        }
      ],
      "expo-sharing",
      [
        "expo-sensors",
        {
          "motionPermission": "Shadowing moves the water when you tilt the phone."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
