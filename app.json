{
  "expo": {
    "name": "Echo Tail",
    "slug": "echo-tail",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/app-icons/f01.png",
    "scheme": "echotail",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/app-icons/f01.png",
      "bundleIdentifier": "build.sean.echotail",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Echo Tail records your voice so it can build a language island from what you say.",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "build.sean.echotail",
      "adaptiveIcon": {
        "backgroundColor": "#201e28",
        "foregroundImage": "./assets/images/app-icons/f01-fg.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Echo Tail attaches the screenshots you pick to your bug report."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E1B3A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Echo Tail records your voice so it can build a language island from what you say.",
          "enableBackgroundPlayback": true
        }
      ],
      "expo-sharing",
      [
        "expo-sensors",
        {
          "motionPermission": "Echo Tail moves the water when you tilt the phone."
        }
      ],
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.788400158570-vqc9qvd0dc1hti80o9ch7k4qofk75a6l"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0f9451b0-d417-4b7c-ad57-ec4aab466450"
      }
    },
    "owner": "waiter"
  }
}
