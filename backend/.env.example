# Keep island data outside the repo: worktree cleanup deletes ignored files.
SHADOW_DATA_DIR=/home/sean/shadowing-data

# Bearer token every /shadow route requires. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The service refuses all requests when this is unset.
SHADOW_TOKEN=

# VOICEVOX engine, started from ~/voicevox/run
VOICEVOX_URL=http://127.0.0.1:50021
# Style id from GET /shadow/speakers. 3 is Zundamon normal.
VOICEVOX_SPEAKER=3

# faster-whisper size. medium and small are both already in the local cache.
WHISPER_MODEL=medium

# Model used for Japanese generation through the local claude CLI.
SHADOW_MODEL=claude-sonnet-5

# Discord webhook URL for relaying feature suggestions. Unset means the
# suggestion route never makes a network call.
SHADOW_DISCORD_WEBHOOK=
