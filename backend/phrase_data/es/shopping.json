  {"text": "¿Cuánto cuesta?", "en": "How much does it cost?"},
  {"text": "Es un poco caro.", "en": "It's a bit expensive."},
  {"text": "¿Puedo probármelo?", "en": "May I try it on?"},
  {"text": "¿Tiene algo más barato?", "en": "Do you have anything cheaper?"},
  {"text": "¿Puedo pagar con tarjeta?", "en": "Can I pay by card?"},
  {"text": "No necesito bolsa.", "en": "I don't need a bag."},
  {"text": "Me lo llevo.", "en": "I'll take it."}
