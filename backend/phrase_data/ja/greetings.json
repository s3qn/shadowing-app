[
  {"text": "おはようございます。", "en": "Good morning."},
  {"text": "こんにちは。", "en": "Hello."},
  {"text": "こんばんは。", "en": "Good evening."},
  {"text": "お久しぶりです。", "en": "It's been a long time."},
  {"text": "お元気ですか。", "en": "How are you?"},
  {"text": "おかげさまで元気です。", "en": "I'm well, thank you."},
  {"text": "また明日。", "en": "See you tomorrow."},
  {"text": "おやすみなさい。", "en": "Good night."}
