[
  {"text": "おはようございます。", "en": "Good morning.", "he": "בוקר טוב."},
  {"text": "こんにちは。", "en": "Hello.", "he": "שלום."},
  {"text": "こんばんは。", "en": "Good evening.", "he": "ערב טוב."},
  {"text": "お久しぶりです。", "en": "It's been a long time.", "he": "מזמן לא התראינו."},
  {"text": "お元気ですか。", "en": "How are you?", "he": "מה שלומך?"},
  {"text": "おかげさまで元気です。", "en": "I'm well, thank you.", "he": "אני בסדר, תודה."},
  {"text": "また明日。", "en": "See you tomorrow.", "he": "נתראה מחר."},
  {"text": "おやすみなさい。", "en": "Good night.", "he": "לילה טוב."}
]
