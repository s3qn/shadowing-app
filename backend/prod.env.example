# Template for /home/sean/shadow-prod/env. Copy it there, fill in
# SHADOW_TOKEN, and chmod 600 the copy. Never commit the filled-in file.
#
# Generate a token with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SHADOW_TOKEN=
SHADOW_DATA_DIR=/home/sean/shadow-prod/data
SHADOW_PORT=8030
SHADOW_ENV=prod
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER=3
WHISPER_MODEL=medium
# --- llm-api ---
# Prod talks to the Anthropic API, never Sean's claude CLI. run-prod.sh refuses
# to start without SHADOW_LLM=api. The key is ANTHROPIC_API_KEY= (or
# CLAUDE_API_KEY=) in this file, or in SHADOW_LLM_KEY_FILE
# (default ~/.config/kageneko/env, mode 600). It is never logged.
SHADOW_LLM=api
# ANTHROPIC_API_KEY=
# Monthly spend stop in USD (UTC month). At the cap every AI call answers
# None and the app shows its existing "AI unavailable" states; cached
# answers still work. Warnings at 50% and 90% go to the Discord webhook.
SHADOW_LLM_MONTHLY_USD=30
# Daily spend stop in USD (UTC day), same behaviour as the monthly one.
SHADOW_LLM_DAILY_USD=5
# Model ids per tier; routes per tag live in backend/llm.py ROUTES and can be
# pinned with SHADOW_LLM_ROUTE_<TAG>=haiku|sonnet|<model id>.
SHADOW_LLM_HAIKU=claude-haiku-5-5
SHADOW_LLM_SONNET=claude-sonnet-5-5
# Repair stays on Sonnet until the golden check (tools/llm-golden.py) says
# Haiku holds; then set this to haiku and restart (no deploy needed).
SHADOW_LLM_ROUTE_REPAIR=sonnet
# --- end llm-api ---
SHADOW_DISCORD_WEBHOOK=
# Sean's phone device id (the X-Shadow-Device value the app sends). Set, the
# islands and practice rows saved before device scoping become this device's
# on startup. Empty leaves them unclaimed.
SHADOW_OWNER_DEVICE=
# Builds one device can start per UTC day: new islands (record, file import,
# podcast) and reworks (regenerate, revoice).
SHADOW_DAILY_CREATES=5
SHADOW_DAILY_REWORKS=3
# bl52-energy: 1 turns on the energy meter (a daily budget per device spent by
# the AI-costing routes, a global daily stop, owner grants). On by default; 0 turns it off.
SHADOW_ENERGY=1
# Units each device gets per UTC day (prices live in backend/energy.py).
SHADOW_DAILY_UNITS=60
# Units every device together can spend per UTC day; past it every charged
# route answers 429 global_limit until 00:00 UTC. Counts calls, not dollars.
SHADOW_GLOBAL_DAILY_UNITS=3000
# Fraction of the global budget at which one Discord warning is sent a day.
SHADOW_ENERGY_WARN=0.8
# Beta only: 1 gives every account the Beta Tester Hat on its next snapshot.
# Existing grants stay when this is removed. Remove at launch.
SHADOW_BETA_GRANT=1
# SHADOW_WHISPER_WARM=1 preloads the whisper medium model at startup (~1.5GB RSS). Default off.
# Comma list of user ids that may open Settings > Admin and flip the beta
# switch for others. Admins start with beta on; everyone else starts off and
# gets only shadowing (beta routes answer 403 not_beta) until an admin flips
# them. The owner device (SHADOW_OWNER_DEVICE) is an admin too.
SHADOW_ADMIN_USERS=
