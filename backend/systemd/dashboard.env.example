# Template for ~/.config/shadow-autostart/dashboard.env, the environment file
# shadow-dashboard.service reads. Copy it there, fill in the hash, and chmod
# 600 the copy. Never commit the filled-in file.
#
# The dashboard stores no plaintext password. Generate the hash with:
#   cd ~/www/dev-sean-build && node server.js --hash 'your-password'
# That prints the whole DASH_PASSWORD_HASH=... line. Paste it below.
DASH_PASSWORD_HASH=

# Optional, both default to what the dashboard already uses. DASH_HOST and
# DASH_PORT are NOT read from here: the unit sets them after this file so the
# bind address stays 127.0.0.1 whatever this file says.
# MAX_ATTEMPTS=5
# ATTEMPT_WINDOW_MS=900000
# BLOCK_MS=900000
# SESSION_TTL_MS=604800000
