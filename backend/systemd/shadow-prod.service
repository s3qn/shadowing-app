# User unit for the shadowing app production backend. This is the documented
# upgrade path from the tmux session; it is not installed automatically. Run
# backend/systemd/install-units.sh to install the whole chain. See
# backend/PROD.md for the deploy story and OPERATIONS.md for autostart.
[Unit]
Description=Shadowing app production backend (127.0.0.1:8030)
Documentation=file:///home/sean/app-projects/shadowing-app/OPERATIONS.md
# Wants, not Requires. A dead VOICEVOX costs voicing and nothing else: every
# other route still answers, so it must not take the backend down with it.
# After only orders the start, it does not wait for VOICEVOX to finish loading
# its models, which is fine because the backend calls VOICEVOX lazily per
# request rather than at import time. A slow VOICEVOX is a slow first voicing,
# never a failed boot.
Wants=shadow-voicevox.service
After=shadow-voicevox.service
# Twenty tries over five minutes, see the Restart comment below.
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
WorkingDirectory=/home/sean/shadow-prod/app/backend
# run-prod.sh binds 127.0.0.1 and refuses port 8020, and it reads its settings
# from /home/sean/shadow-prod/env rather than this checkout's backend/.env, so
# the dev and prod data directories cannot collide.
ExecStart=/home/sean/shadow-prod/app/backend/run-prod.sh
Environment=PATH=/home/sean/.local/bin:/usr/local/bin:/usr/bin:/bin

# always, not on-failure. uvicorn exits 0 only when something told it to stop,
# and an explicit `systemctl --user stop` never triggers Restart, so `always`
# costs nothing and covers the case where a stray kill takes the backend down
# cleanly. This is the service every tester's phone talks to.
#
# It does keep a start limit, unlike VOICEVOX and cloudflared. The failures
# this one has are configuration failures that repeat forever: an env file
# that is not mode 600, an empty SHADOW_TOKEN, a venv symlink pointing at a
# deleted venv. Twenty tries over five minutes rides out a slow boot, then the
# unit lands in `failed` where shadow-health.sh reports it.
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
